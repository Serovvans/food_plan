APP_PASSWORD=your_secure_password
NEXTAUTH_SECRET=generate_with_openssl_rand_-base64_32
NEXTAUTH_URL=http://localhost:3000

# Supabase PostgreSQL
# DATABASE_URL — pooler URL (port 6543) for runtime
DATABASE_URL=postgresql://postgres.YOURPROJECT:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL — direct URL (port 5432) for migrations
DIRECT_URL=postgresql://postgres.YOURPROJECT:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=random_secret_string
CRON_SECRET=random_secret_for_cron
